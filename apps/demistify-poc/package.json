{
	"name": "@sunstack/demistify-poc",
	"version": "0.1.0",
	"private": true,
	"description": "Five independent presentation experiments and Demistify showcases",
	"type": "module",
	"scripts": {
		"build": "node scripts/build-experiments.ts && vite build",
		"dev:serve": "vite --host 127.0.0.1",
		"preview": "vite preview --host 127.0.0.1",
		"islands:package": "node scripts/build-experiments.ts --reuse-runtime --islands-only",
		"test": "node scripts/build-experiments.ts && vitest run",
		"test:browser": "vitest run --config vitest.browser.config.ts"
	},
	"dependencies": {
		"@sunstack/demistify": "workspace:*",
		"@terrastruct/d2": "0.1.33",
		"js-tiktoken": "1.0.21",
		"rehype-stringify": "10.0.1",
		"remark-directive": "4.0.0",
		"remark-gfm": "4.0.1",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"unified": "11.0.5",
		"vplan": "0.24.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@vitest/browser-playwright": "5.0.4",
		"parse5": "7.3.0",
		"playwright": "1.64.0"
	}
}
