{
	"name": "sunstack-demistify",
	"main": "worker.ts",
	"compatibility_date": "2026-10-16",
	"workers_dev": true,
	"preview_urls": false,
	"send_metrics": false,
	"assets": {
		"directory": "../../../tmp/demistify-release/public",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "none"
	},
	"routes": [
		{
			"pattern": "demistify.getagentstudio.dev",
			"custom_domain": true,
			"zone_name": "getagentstudio.dev"
		}
	]
}
