{
  "$schema": "https://github.com/ShravanSunder/sunstack-tools/releases/download/v0.1.0/sunstack.lint.schema.json",
  "rulebook": [
    {
      "markdown": "rules/rulebook.md",
      "rules": "rules/rules.json"
    }
  ],
  "marker_prefix": "K",
  "check": {
    "files": [
      "docs/*.md"
    ]
  },
  "evidence": {
    "ast_grep": "evidence/sgconfig.yml",
    "kinds": {
      "paragraph": {
        "rule": "paragraph",
        "fields": {
          "body": {
            "from": "remainder"
          }
        }
      },
      "document": {
        "rule": "document",
        "fields": {
          "description": {
            "from": "yaml",
            "key": "description"
          }
        }
      }
    }
  },
  "decision_model": {
    "model": "jev-latest",
    "endpoint": "http://127.0.0.1:64966/systemone"
  }
}
