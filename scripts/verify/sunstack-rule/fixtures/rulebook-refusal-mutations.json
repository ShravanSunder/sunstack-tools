{\n          \"combine\": {\n            \"covers\": 0.6,\n            \"checkable\": 0.4\n          },\n          \"yes_at_or_above\": 1e9999,\n          \"no_at_or_below\": 0.6,\n          \"yes\": \"pass\",\n          \"no\": {\n            \"finding\": \"Completion is incomplete or not checkable.\",\n            \"at\": \"completion\"\n          }\n        }\n      }\n    }\n  },\n  \"K002\": {\n    \"name\": \"description_length\",\n    \"evidence\": \"skill\",\n    \"severity\": \"error\",\n    \"decision\": {\n      \"start\": \"under_300\",\n      \"steps\": {\n        \"under_300\": {\n          \"mechanical_check\": {\n            \"tool\": \"max_chars\",\n            \"field\": \"description\",\n            \"max\": 300\n          },\n          \"yes\": \"pass\",\n          \"no\": {\n            \"finding\": \"Over 300 characters.\",\n            \"at\": \"description\"\n          }\n        }\n      }\n    }\n  },\n  \"K003\": {\n    \"name\": \"description_trigger\",\n    \"evidence\": \"skill\",\n    \"questions\": {\n      \"names_trigger\": {\n        \"type\": \"noul\",\n        \"instructions\": {\n          \"check\": \"description\",\n          \"task\": \"Does the description name when to use this skill?\"\n        }\n      }\n    },\n    \"decision\": {\n      \"start\": \"names_trigger\",\n      \"steps\": {\n        \"names_trigger\": {\n          \"ask\": \"names_trigger\",\n          \"yes_at_or_above\": 0.8,\n          \"no_at_or_below\": 0.6,\n          \"yes\": \"pass\",\n          \"no\": {\n            \"finding\": \"Description does not name its trigger.\",\n            \"at\": \"description\"\n          }\n        }\n      }\n    }\n  }\n}\n"
