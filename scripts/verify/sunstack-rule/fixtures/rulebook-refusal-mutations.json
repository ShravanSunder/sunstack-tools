n\",\n        \"fields\": {\n          \"heading\": {\n            \"from\": \"first_line\"\n          },\n          \"body\": {\n            \"from\": \"remainder\"\n          }\n        }\n      }\n    }\n  },\n  \"decision_model\": {\n    \"model\": \"openai/gpt-4.1-mini\",\n    \"endpoint\": \"http://127.0.0.1:9/systemone\"\n  }\n}\n"
