{
	"name": "sunstack-tools",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm --filter @sunstack/demistify build && pnpm --filter @sunstack/demistify-poc build",
		"dev": "pnpm build && pnpm --filter @sunstack/demistify-poc dev:serve",
		"preview": "pnpm --filter @sunstack/demistify-poc preview",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware --max-warnings 0 packages/demistify apps/demistify-poc scripts/release/*.ts scripts/verify/sunstack-rule/*.ts",
		"fmt": "oxfmt packages/demistify apps/demistify-poc docs/wip/demystify package.json pnpm-workspace.yaml tsconfig.json .oxlintrc.json .oxfmtrc.json .github .changeset scripts/release/*.ts scripts/verify/sunstack-rule/*.ts",
		"fmt:check": "oxfmt --check packages/demistify apps/demistify-poc docs/wip/demystify package.json pnpm-workspace.yaml tsconfig.json .oxlintrc.json .oxfmtrc.json .github .changeset scripts/release/*.ts scripts/verify/sunstack-rule/*.ts",
		"check": "pnpm lint && pnpm fmt:check && pnpm typecheck",
		"test": "pnpm --filter @sunstack/demistify-poc test",
		"changeset": "changeset",
		"version-packages": "changeset version && pnpm install --lockfile-only",
		"release:prepare": "node packages/demistify/release/prepare-release.ts",
		"release:verify": "node packages/demistify/release/verify-release.ts",
		"release:check": "node packages/demistify/release/check-release-intent.ts",
		"test:browser": "pnpm --filter @sunstack/demistify-poc test:browser",
		"test:scripts": "vitest run --testTimeout 20000 scripts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@types/node": "26.6.5",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"oxlint-tsgolint": "7.0.2004",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.4",
		"wrangler": "4.151.1",
		"zod": "4.4.3"
	},
	"engines": {
		"node": ">=26.0.0"
	},
	"packageManager": "pnpm@12.11.2"
}
