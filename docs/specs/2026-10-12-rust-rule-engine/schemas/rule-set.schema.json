{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule-set.schema.json",
  "title": "RuleSet definition",
  "$ref": "#/$defs/RuleSet",
  "$defs": {
    "RuleSet": {
      "type": "object",
      "properties": {
        "schema_version": { "const": 1 },
        "name": {
          "description": "For people and agents choosing RuleSets. Never model instructions or an execution condition.",
          "type": "string",
          "minLength": 1
        },
        "description": {
          "description": "What this RuleSet checks. Never sent to the model.",
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "evidence-declaration.schema.json#/$defs/InputName" },
          "additionalProperties": { "$ref": "#/$defs/InputDeclaration" }
        },
        "applicability": { "$ref": "applicability.schema.json#/$defs/ApplicabilityList" },
        "common_ruleset_instructions": {
          "description": "Applied to this RuleSet's rule questions and noul verdicts only. Null adds nothing.",
          "$ref": "decision-question.schema.json#/$defs/StructuredEntry"
        },
        "rule_paths": {
          "description": "Ordered JSONL files, relative to this RuleSet file. Duplicate normalized paths are refused at admission.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "required": ["schema_version", "name", "description", "inputs", "applicability", "common_ruleset_instructions", "rule_paths"],
      "additionalProperties": false
    },
    "InputDeclaration": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "kind": { "const": "document" } },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "kind": { "const": "conversation" } },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "kind": { "const": "change_set" } },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "payload" },
            "schema": {
              "description": "A name in the invocation's payload schema catalog. This declaration's schema governs; a binding cannot substitute another.",
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "schema"],
          "additionalProperties": false
        }
      ]
    }
  }
}
