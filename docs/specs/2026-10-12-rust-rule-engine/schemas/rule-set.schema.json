{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule-set.schema.json",
  "title": "RuleSet definition",
  "$ref": "#/$defs/RuleSet",
  "$defs": {
    "RuleSet": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "rule_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "instruction_prefix": {
          "$ref": "decision-question.schema.json#/$defs/StructuredEntry"
        }
      },
      "required": [
        "schema_version",
        "name",
        "description",
        "rule_paths",
        "instruction_prefix"
      ],
      "additionalProperties": false
    }
  }
}
