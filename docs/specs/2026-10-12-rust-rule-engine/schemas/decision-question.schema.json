{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-question.schema.json",
  "title": "Decision question",
  "$ref": "#/$defs/JudgmentQuestion",
  "$defs": {
    "StructuredJson": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StructuredJson"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/StructuredJson"
          }
        }
      ]
    },
    "StructuredEntry": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StructuredJson"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/StructuredJson"
          }
        }
      ]
    },
    "NoulCriteria": {
      "type": "object",
      "properties": {
        "true": {
          "$ref": "#/$defs/StructuredEntry"
        },
        "false": {
          "$ref": "#/$defs/StructuredEntry"
        }
      },
      "required": [
        "true",
        "false"
      ],
      "additionalProperties": false
    },
    "NoulQuestion": {
      "type": "object",
      "properties": {
        "type": {
          "const": "noul"
        },
        "instructions": {
          "$ref": "#/$defs/StructuredEntry"
        },
        "criteria": {
          "$ref": "#/$defs/NoulCriteria"
        }
      },
      "required": [
        "type",
        "instructions"
      ],
      "additionalProperties": false
    },
    "ChoiceQuestion": {
      "type": "object",
      "properties": {
        "type": {
          "const": "choice"
        },
        "instructions": {
          "$ref": "#/$defs/StructuredEntry"
        },
        "criteria": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/StructuredEntry"
          }
        }
      },
      "required": [
        "type",
        "instructions",
        "criteria"
      ],
      "additionalProperties": false
    },
    "ScoreQuestion": {
      "type": "object",
      "properties": {
        "type": {
          "const": "score"
        },
        "instructions": {
          "$ref": "#/$defs/StructuredEntry"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/StructuredEntry"
          }
        }
      },
      "required": [
        "type",
        "instructions",
        "criteria"
      ],
      "additionalProperties": false
    },
    "JudgmentQuestion": {
      "oneOf": [
        {
          "$ref": "#/$defs/NoulQuestion"
        },
        {
          "$ref": "#/$defs/ChoiceQuestion"
        },
        {
          "$ref": "#/$defs/ScoreQuestion"
        }
      ]
    },
    "NamedQuestions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/JudgmentQuestion"
      }
    }
  }
}
