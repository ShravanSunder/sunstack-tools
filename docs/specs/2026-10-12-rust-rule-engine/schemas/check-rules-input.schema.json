        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "path"
      ]
    },
    "QueryPath": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "exact"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "glob"
            },
            "pattern": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "pattern"
          ]
        }
      ]
    },
    "RepositoryBinding": {
      "type": "object",
      "properties": {
        "change_scope": {
          "$ref": "#/$defs/ChangeScope"
        },
        "input_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QueryPath"
          }
        },
        "key": {
          "$ref": "#/$defs/RepositoryId"
        },
        "root": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "root",
        "input_paths",
        "change_scope"
      ]
    },
    "RepositoryId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "type": "string",
      "minLength": 1
    },
    "RevisionHead": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "commit"
            },
            "revision": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "revision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "worktree"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "SchemaName": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "type": "string",
      "minLength": 1
    },
    "StructuredJson": {
      "description": "Recursive JSON content. This is data, never a declaration or an executable expression.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StructuredJson"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/StructuredJson"
          }
        }
      ]
    },
    "TimeWindow": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "lookback"
            },
            "seconds": {
              "type": "integer",
              "format": "uint",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "seconds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "absolute"
            },
            "since_utc": {
              "type": "string",
              "format": "date-time"
            },
            "until_utc": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "since_utc",
            "until_utc"
          ]
        }
      ]
    },
    "TranscriptFormatName": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "UnknownRecencyPolicy": {
      "type": "string",
      "enum": [
        "include_with_diagnostic",
        "exclude_with_omission"
      ]
    }
  },
  "$id": "check-rules-input.schema.json",
  "$comment": "Generated from the owning sunstack-rules Rust contract with schemars."
}
