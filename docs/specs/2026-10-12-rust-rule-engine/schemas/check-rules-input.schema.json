            "kind": {
              "type": "string",
              "const": "router"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "binding_groups"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rule_sets"
            },
            "rule_sets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/BoundRuleSet"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "rule_sets"
          ]
        }
      ]
    },
    "InvocationLimits": {
      "type": "object",
      "properties": {
        "include_ignored": {
          "type": "boolean"
        },
        "max_file_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 1
        },
        "max_files": {
          "type": "integer",
          "format": "uint",
          "minimum": 1
        },
        "max_matches": {
          "type": "integer",
          "format": "uint",
          "minimum": 1
        },
        "max_total_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 1
        },
        "max_transcript_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 1
        }
