{
  "$defs": {
    "CandidateDefinitions": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "router",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "rule_sets",
              "type": "string"
            },
            "rule_sets": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "rule_sets"
          ],
          "type": "object"
        }
      ]
    },
    "CheckRulesOutput": {
      "enum": [
        "diagnostics",
        "assembled_rules"
      ],
      "type": "string"
    },
    "DefinitionLimits": {
      "additionalProperties": false,
      "properties": {
        "max_file_bytes": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_file_bytes"
      ],
      "type": "object"
    },
    "PayloadSchemaPath": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/SchemaName"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path"
      ],
      "type": "object"
    },
    "SchemaName": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "minLength": 1,
      "title": "string",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "definition_root": {
      "minLength": 1,
      "type": "string"
    },
    "definitions": {
      "$ref": "#/$defs/CandidateDefinitions"
    },
    "limits": {
      "$ref": "#/$defs/DefinitionLimits"
    },
    "output": {
      "$ref": "#/$defs/CheckRulesOutput"
    },
    "payload_schemas": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PayloadSchemaPath"
      },
      "type": "array"
    }
  },
  "required": [
    "definition_root",
    "definitions",
    "limits",
    "output"
  ],
  "title": "CheckDefinitionsInput",
  "type": "object",
  "$id": "https://sunstack.dev/schemas/check-rules-input.schema.json"
}
