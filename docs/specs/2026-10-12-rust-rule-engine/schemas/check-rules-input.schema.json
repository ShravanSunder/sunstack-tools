      "additionalProperties": false,
      "required": [
        "max_files",
        "max_file_bytes",
        "max_total_bytes",
        "max_matches",
        "max_transcript_bytes",
        "include_ignored"
      ]
    },
    "PayloadSchemaPath": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/SchemaName"
