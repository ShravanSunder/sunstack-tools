            "limits": {
              "$ref": "#/$defs/DiscoveryLimits"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "limits"
          ]
        }
      ]
    },
    "GitObjectId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "string",
      "type": "string",
      "minLength": 1
    },
    "InputBinding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "document"
            },
            "path": {
              "type": "string"
            },
            "repository": {
              "$ref": "#/$defs/RepositoryId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "repository",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "final_assistant_text": {
              "type": [
                "string",
