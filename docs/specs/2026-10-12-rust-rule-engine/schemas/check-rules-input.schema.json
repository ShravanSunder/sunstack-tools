          },
          "additionalProperties": false,
          "required": [
            "kind",
            "transcript_path",
            "format"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "payload"
            },
            "value": {
              "$ref": "#/$defs/StructuredJson"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "change_set"
            },
            "repository": {
              "$ref": "#/$defs/RepositoryId"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "repository"
          ]
        }
      ]
    },
    "InvocationDefinitions": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "binding_groups": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/BindingGroup"
              },
              "minItems": 1
