{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-binding.schema.json",
  "title": "Skill and rule-file association",
  "$ref": "#/$defs/SkillRuleBinding",
  "$defs": {
    "SkillRuleBinding": {
      "type": "object",
      "properties": {
        "repository_id": {
          "$ref": "evidence-selector.schema.json#/$defs/RepositoryId"
        },
        "skill_path": {
          "type": "string",
          "minLength": 1
        },
        "rule_set_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "repository_id",
        "skill_path",
        "rule_set_paths"
      ],
      "additionalProperties": false
    }
  }
}
