flowchart TB
  subgraph Skill["Skill creator or updater — U4, U7, U14 to U17"]
    direction TB
    S1["Create or update a skill"] --> S2["Choose its RuleSets"]
    S2 --> S3["Evaluate with relevant source context"]
    S3 --> S4["Read paragraph-linked answers<br/>repair and check again"]
    S2 -.-> SG["Current gap: no runnable engine<br/>latency and model accuracy unmeasured"]
  end
  subgraph Monitor["Agent-workflow owner — U24 to U30"]
    direction TB
    M1["Lead sends a typed commission"] --> M2["Reviewer works and hands back"]
    M2 --> M3["Host hook passes session, transcript<br/>and commission to the engine"]
    M3 --> M4["Host receives per-rule answers<br/>nudge or block, with unknowns visible"]
    M2 -.-> MG["Current gap: helper reads messages only<br/>no check of which files were read"]
  end
  subgraph Native["Rust or program consumer — U1, U8, U18, U20 to U23"]
    direction TB
    N1["Supply repo paths and a change window"] --> N2["Inspect connected callers and evidence"]
    N2 --> N3["Ask a bounded rule judgment"]
    N3 --> N4["Handle typed answers or diagnostics<br/>caller keeps its action policy"]
    N2 -.-> NG["Current gap: no shared runnable path<br/>cross-repo retrieval quality unmeasured"]
  end
