flowchart TB
  Hook["Host hook, skill tool or TS caller"] -->|"one JSON request"| CLI["sunstack-rule-cli<br/>framing, signals, exit codes"]
  Native["Native Rust host"] -->|"typed call"| Inv
  CLI -->|"prepare_rules, evaluate_rules"| Inv
  subgraph Rules["sunstack-rules"]
    direction TB
    Inv["Invocation owner<br/>admission, scheduler, terminal outcome"]
    Def["Definition admission<br/>RuleSets, rule lines, routers"]
    Bind["Input binding<br/>groups, route wiring, origin"]
    Plan["Request planning<br/>gate slots, staging, splits"]
    App["Applicability and reduction<br/>conditions in authored order"]
    Ver["Verdict evaluation<br/>threshold, band, composite"]
    Rep["Report<br/>occurrences, requests, cursors"]
    Inv --> Def --> Bind --> Plan -->|"settled requests"| App --> Ver --> Rep
  end
  subgraph Evidence["sunstack-evidence"]
    direction TB
    Docs["Documents: capture, paragraphs, text and AST"]
    Conv["Conversations: capture, adapters, selection, cursor"]
    Pay["Payloads: schema catalog, pointers"]
    Chg["Change sets: milestone 2"]
  end
  subgraph Decisions["sunstack-decisions"]
    direction TB
    Judge["Judgment owner<br/>budget, admission, validation"]
    Jev["Jev adapter<br/>attempts, private credentials"]
    Judge --> Jev
  end
  Bind -->|"validate payloads"| Evidence
  Plan -->|"owner-labeled selections"| Evidence
  Plan -->|"requests"| Decisions
  Jev <-->|"HTTP"| OR["OpenRouter System One"]
  CLI -.->|"prepare_evidence"| Evidence
  CLI -.->|"run_judgments"| Decisions
