flowchart TB
  RS["RuleSet JSON<br/>inputs, applicability,<br/>common_ruleset_instructions, rule_paths"] --> Adm["Definition admission<br/>strict fields, references, verdicts, bands"]
  RL["Rule lines (JSONL)<br/>evidence, target, applicability,<br/>questions, verdict, severity"] --> Adm
  RT["Router JSON (optional)<br/>inputs, evidence, choice, routes, floor"] --> Adm
  B["Binding groups<br/>document, conversation, payload"] --> Bind["Binding admission<br/>every input once, payload schema valid"]
  Adm --> Plan["Request planning per RuleSet x group"]
  Bind --> Plan
  Plan -->|"each declaration"| Sel["Evidence selection<br/>labeled owner/declaration"]
  Sel -->|"ready"| State["Request state<br/>labels to deduplicated contents"]
  Sel -->|"required refused"| Fail["Owner refused<br/>no question sent"]
  Plan -->|"verdict + informational + riding gates"| Q["Questions q000001...<br/>instruction wrapper: owner, reads,<br/>common instructions, question"]
  State --> Req["One structured request"]
  Q --> Req
  Req -->|"budget, then Jev"| Ans["Validated answer map"]
  Ans --> Red["Reduction in authored order<br/>gates, conditions, verdicts"]
