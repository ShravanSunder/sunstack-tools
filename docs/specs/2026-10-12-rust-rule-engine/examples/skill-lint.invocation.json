    "attempt_timeout_ms": 10000,
    "retry_count": 0,
    "initial_backoff_ms": 500,
    "max_backoff_ms": 4000,
    "max_response_bytes": 1048576
  },
  "request_budget": {
    "max_input_tokens": 32000,
    "max_request_bytes": 262144,
    "max_questions": 32,
    "max_requests": 4,
    "safety_margin_tokens": 2000,
    "accounting_policy": "allow_estimated"
  }
