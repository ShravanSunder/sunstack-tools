{
  "definition_root": "docs/specs/2026-10-12-rust-rule-engine/examples",
  "definitions": {
    "kind": "rule_sets",
    "rule_sets": [
      {
        "path": "skill-quality.ruleset.json",
        "binding_groups": [
          {
            "bindings": {
              "skill": {
                "kind": "document",
                "repository": "sunstack-tools",
                "path": "docs/specs/2026-10-12-rust-rule-engine/examples/SKILL.md"
              }
            }
          }
        ]
      }
    ]
  },
  "repositories": [
    {
      "key": "sunstack-tools",
      "root": ".",
      "input_paths": [{ "kind": "exact", "path": "docs/specs/2026-10-12-rust-rule-engine/examples/SKILL.md" }],
      "change_scope": { "kind": "full" }
    }
  ],
  "payload_schemas": [],
  "origin": { "kind": "direct" },
  "cursors": [],
  "execution": { "speculation": "off", "max_concurrent_requests": 4 },
  "limits": {
    "max_files": 16,
    "max_file_bytes": 262144,
    "max_total_bytes": 1048576,
    "max_matches": 64,
    "max_transcript_bytes": 8388608,
    "include_ignored": false
  },
  "backend": { "kind": "jev_openrouter", "endpoint": "https://openrouter.ai/api/v1/systemone", "model": "jev-latest", "context_ceiling_tokens": 262144 },
