                "path": "docs/specs/2026-10-12-rust-rule-engine/examples/mechanical-skill.md"
              }
            }
          }
        ]
      }
    ]
  },
  "repositories": [
    {
      "key": "sunstack-tools",
      "root": ".",
      "input_paths": [
        {
          "kind": "exact",
          "path": "docs/specs/2026-10-12-rust-rule-engine/examples/mechanical-skill.md"
        }
      ],
      "change_scope": {
        "kind": "full"
      }
    }
