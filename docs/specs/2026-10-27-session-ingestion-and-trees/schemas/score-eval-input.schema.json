{
  "$defs": {
    "AccountingPolicy": {
      "enum": [
        "require_exact",
        "allow_estimated"
      ],
      "type": "string"
    },
    "AttemptSettings": {
      "additionalProperties": false,
      "properties": {
        "attempt_timeout_ms": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "initial_backoff_ms": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "max_backoff_ms": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "max_response_bytes": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "retry_count": {
          "format": "uint32",
          "maximum": 4294967294,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "attempt_timeout_ms",
        "retry_count",
        "initial_backoff_ms",
        "max_backoff_ms",
        "max_response_bytes"
      ],
      "type": "object"
    },
    "BackendSelection": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "context_ceiling_tokens": {
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            },
            "endpoint": {
              "type": "string"
            },
            "kind": {
              "const": "jev_openrouter",
              "type": "string"
            },
            "model": {
              "$ref": "#/$defs/ModelName"
            }
          },
          "required": [
            "kind",
            "endpoint",
            "model"
          ],
          "type": "object"
        }
      ]
    },
    "ChangeScope": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "full",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uncommitted",
              "type": "string"
            },
            "layers": {
              "items": {
                "$ref": "#/$defs/DirtyLayer"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "layers"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "base_revision": {
              "type": "string"
            },
            "head": {
              "$ref": "#/$defs/RevisionHead"
            },
            "kind": {
              "const": "revision_diff",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "base_revision",
            "head"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "commit_ids": {
              "items": {
                "$ref": "#/$defs/GitObjectId"
              },
              "type": "array"
            },
            "kind": {
              "const": "commit_set",
              "type": "string"
            },
            "parent_policy": {
              "$ref": "#/$defs/CommitParentPolicy"
            }
          },
          "required": [
            "kind",
            "commit_ids",
            "parent_policy"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "recent_commits",
              "type": "string"
            },
            "parent_policy": {
              "$ref": "#/$defs/CommitParentPolicy"
            },
            "reference": {
              "type": "string"
            },
            "window": {
              "$ref": "#/$defs/TimeWindow"
            }
          },
          "required": [
            "kind",
            "reference",
            "window",
            "parent_policy"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "recent_uncommitted",
              "type": "string"
            },
            "layers": {
              "items": {
                "$ref": "#/$defs/DirtyLayer"
              },
              "type": "array"
            },
            "unknown_recency": {
              "$ref": "#/$defs/UnknownRecencyPolicy"
            },
            "window": {
              "$ref": "#/$defs/TimeWindow"
            }
          },
          "required": [
            "kind",
            "layers",
            "window",
            "unknown_recency"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "union",
              "type": "string"
            },
            "members": {
              "items": {
                "$ref": "#/$defs/ChangeScope"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "members"
          ],
          "type": "object"
        }
      ]
    },
    "CommitParentPolicy": {
      "enum": [
        "first_parent",
        "each_parent"
      ],
      "type": "string"
    },
    "DirtyLayer": {
      "enum": [
        "staged",
        "unstaged",
        "untracked"
      ],
      "type": "string"
    },
    "DiscoveryLimits": {
      "additionalProperties": false,
      "properties": {
        "include_ignored": {
          "type": "boolean"
        },
        "max_fan_out": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_file_bytes": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_files": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_history_commits": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_local_time_ms": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_matches": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_relationship_candidates": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_total_bytes": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_unit_visits": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_files",
        "max_file_bytes",
        "max_total_bytes",
        "max_matches",
        "include_ignored",
        "max_unit_visits",
        "max_relationship_candidates",
        "max_fan_out",
        "max_history_commits",
        "max_local_time_ms"
      ],
      "type": "object"
    },
    "EvidenceBinding": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "binding": {
              "$ref": "#/$defs/InputBinding"
            },
            "kind": {
              "const": "bound",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "binding"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unavailable",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/UnavailableReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "EvidenceDiscovery": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "bounded",
              "type": "string"
            },
            "limits": {
              "$ref": "#/$defs/DiscoveryLimits"
            }
          },
          "required": [
            "kind",
            "limits"
          ],
          "type": "object"
        }
      ]
    },
    "ExecutionSettings": {
      "additionalProperties": false,
      "properties": {
        "max_concurrent_requests": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "speculation": {
          "$ref": "#/$defs/Speculation"
        }
      },
      "required": [
        "speculation",
        "max_concurrent_requests"
      ],
      "type": "object"
    },
    "GitObjectId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "minLength": 1,
      "title": "string",
      "type": "string"
    },
    "InputBinding": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "document",
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "repository": {
              "$ref": "#/$defs/RepositoryId"
            }
          },
          "required": [
            "kind",
            "repository",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "final_assistant_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "format": {
              "$ref": "#/$defs/TranscriptFormatName"
            },
            "kind": {
              "const": "conversation",
              "type": "string"
            },
            "transcript_path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "transcript_path",
            "format"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "payload",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/StructuredJson"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "change_set",
              "type": "string"
            },
            "repository": {
              "$ref": "#/$defs/RepositoryId"
            }
          },
          "required": [
            "kind",
            "repository"
          ],
          "type": "object"
        }
      ]
    },
    "InvocationLimits": {
      "additionalProperties": false,
      "properties": {
        "include_ignored": {
          "type": "boolean"
        },
        "max_file_bytes": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_files": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_matches": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_total_bytes": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_transcript_bytes": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_files",
        "max_file_bytes",
        "max_total_bytes",
        "max_matches",
        "max_transcript_bytes",
        "include_ignored"
      ],
      "type": "object"
    },
    "ModelName": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "minLength": 1,
      "title": "string",
      "type": "string"
    },
    "ProviderName": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "minLength": 1,
      "title": "string",
      "type": "string"
    },
    "ProviderRecipe": {
      "additionalProperties": false,
      "properties": {
        "locate": {
          "$ref": "#/$defs/SessionLocation"
        },
        "map": {
          "$ref": "#/$defs/RecordMapping",
          "default": {
            "fields": {}
          }
        },
        "provider": {
          "$ref": "#/$defs/ProviderName"
        },
        "read": {
          "$ref": "#/$defs/TranscriptReading"
        }
      },
      "required": [
        "provider",
        "locate",
        "read"
      ],
      "type": "object"
    },
    "QueryPath": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "exact",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "glob",
              "type": "string"
            },
            "pattern": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "pattern"
          ],
          "type": "object"
        }
      ]
    },
    "RecordMapping": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "fields"
      ],
      "type": "object"
    },
    "RepositoryBinding": {
      "additionalProperties": false,
      "properties": {
        "change_scope": {
          "$ref": "#/$defs/ChangeScope"
        },
        "input_paths": {
          "items": {
            "$ref": "#/$defs/QueryPath"
          },
          "type": "array"
        },
        "key": {
          "$ref": "#/$defs/RepositoryId"
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "root",
        "input_paths",
        "change_scope"
      ],
      "type": "object"
    },
    "RepositoryId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "minLength": 1,
      "title": "string",
      "type": "string"
    },
    "RequestBudgetSettings": {
      "additionalProperties": false,
      "properties": {
        "accounting_policy": {
          "$ref": "#/$defs/AccountingPolicy"
        },
        "max_input_tokens": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "max_questions": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_request_bytes": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "max_requests": {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        "safety_margin_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_input_tokens",
        "max_request_bytes",
        "max_questions",
        "max_requests",
        "safety_margin_tokens",
        "accounting_policy"
      ],
      "type": "object"
    },
    "RevisionHead": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "commit",
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "revision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "worktree",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "SessionLocation": {
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string"
        },
        "roots": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "roots",
        "pattern"
      ],
      "type": "object"
    },
    "Speculation": {
      "enum": [
        "off",
        "on"
      ],
      "type": "string"
    },
    "StructuredJson": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/StructuredJson"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/StructuredJson"
          },
          "type": "object"
        }
      ],
      "description": "Recursive JSON content. This is data, never a declaration or an executable expression."
    },
    "TimeWindow": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "lookback",
              "type": "string"
            },
            "seconds": {
              "format": "uint",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "seconds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "absolute",
              "type": "string"
            },
            "since_utc": {
              "format": "date-time",
              "type": "string"
            },
            "until_utc": {
              "format": "date-time",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "since_utc",
            "until_utc"
          ],
          "type": "object"
        }
      ]
    },
    "TranscriptFormatName": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "maxLength": 128,
      "minLength": 1,
      "title": "string",
      "type": "string"
    },
    "TranscriptReading": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "$ref": "#/$defs/TranscriptFormatName"
        }
      },
      "required": [
        "format"
      ],
      "type": "object"
    },
    "UnavailableReason": {
      "enum": [
        "not_recorded",
        "withheld",
        "unknown"
      ],
      "type": "string"
    },
    "UnknownRecencyPolicy": {
      "enum": [
        "include_with_diagnostic",
        "exclude_with_omission"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempts": {
      "$ref": "#/$defs/AttemptSettings"
    },
    "backend": {
      "$ref": "#/$defs/BackendSelection"
    },
    "case_set": {
      "minLength": 1,
      "type": "string"
    },
    "discovery": {
      "$ref": "#/$defs/EvidenceDiscovery",
      "default": {
        "kind": "none"
      }
    },
    "evidence": {
      "additionalProperties": false,
      "default": {},
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "$ref": "#/$defs/EvidenceBinding"
        }
      },
      "type": "object"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionSettings"
    },
    "limits": {
      "$ref": "#/$defs/InvocationLimits"
    },
    "recipes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProviderRecipe"
      },
      "type": "array"
    },
    "repositories": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RepositoryBinding"
      },
      "type": "array"
    },
    "request_budget": {
      "$ref": "#/$defs/RequestBudgetSettings"
    }
  },
  "required": [
    "case_set",
    "limits",
    "backend",
    "attempts",
    "request_budget",
    "execution"
  ],
  "title": "EvalRunInput",
  "type": "object",
  "$id": "score-eval-input.schema.json"
}
