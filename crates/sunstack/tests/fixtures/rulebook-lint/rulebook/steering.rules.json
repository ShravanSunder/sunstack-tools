            "other": {
              "finding": "Completion does not describe an outcome.",
              "at": "completion"
            }
          }
        },
        "quality": {
          "combine": {
            "covers": 0.6,
            "checkable": 0.4
          },
          "yes_at_or_above": 0.8,
          "no_at_or_below": 0.6,
          "yes": "pass",
          "no": {
            "finding": "Completion is incomplete or not checkable.",
            "at": "completion"
          }
        }
      }
    }
  },
