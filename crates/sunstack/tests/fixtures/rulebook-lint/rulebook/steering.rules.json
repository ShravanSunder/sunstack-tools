          "check": "completion",
          "task": "How checkable is this completion?"
        },
        "criteria": [
          "Not checkable.",
          "Partly checkable.",
          "Directly checkable."
        ]
      }
    },
    "decision": {
      "start": "has_completion",
      "steps": {
